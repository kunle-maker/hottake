# HotTakes™ Production Environment Variables

# App & Server Config
PORT=3000
NODE_ENV=production
CLIENT_URL=https://hottakes-football.onrender.com

# PostgreSQL Database Connection String (Render / Local)
DATABASE_URL=postgresql://hottakes_user:securepassword@localhost:5432/hottakes_db

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_hottakes_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_hottakes_2026

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://hottakes-football.onrender.com/api/auth/google/callback

# API-FOOTBALL (https://www.api-football.com / RapidAPI)
API_FOOTBALL_KEY=your_api_football_key_here

# Cloudinary Media Storage (Photos & Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini 3.6 AI Hot Take Engine
GEMINI_API_KEY=your_gemini_api_key_here
